model User {
  id            String    @id
  email         String
  username      String    @unique @db.VarChar(100)
  name          String    @db.VarChar(100)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}